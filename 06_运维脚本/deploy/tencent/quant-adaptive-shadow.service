[Unit]
Description=AI hourly strategy shadow observer (no orders)
Wants=network-online.target
After=network-online.target
OnFailure=quant-alert@%n.service

[Service]
Type=simple
User=quant-adaptive
Group=quant-adaptive
WorkingDirectory=/opt/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
UnsetEnvironment=BINANCE_API_KEY BINANCE_API_SECRET BINANCE_BASE_URL BINANCE_TESTNET_API_KEY BINANCE_TESTNET_API_SECRET
EnvironmentFile=/etc/quant-ai.env
EnvironmentFile=-/etc/quant-alert.env
StateDirectory=quant-adaptive
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/quant-venv/bin/quant crypto adaptive-run --mode shadow --db /var/lib/quant-adaptive/adaptive.sqlite
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/quant-adaptive
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
