[Unit]
Description=BTC ETH hourly signal observer (no order execution)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=quant-observer
Group=quant-observer
WorkingDirectory=/opt/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
UnsetEnvironment=BINANCE_API_KEY BINANCE_API_SECRET BINANCE_TESTNET_API_KEY BINANCE_TESTNET_API_SECRET
StateDirectory=quant-observer
StateDirectoryMode=0700
UMask=0077
ExecStart=/bin/bash /opt/quant/deploy/tencent/run-observer.sh
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/quant-observer
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
